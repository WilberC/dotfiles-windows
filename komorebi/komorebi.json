{
	"$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json",
	"default_layout": "BSP",
	"window_container_behaviour": "Create",
	"cross_monitor_move_behaviour": "Insert",
	"display_index_preferences": {
		"0": "DISPLAY1",
		"1": "DISPLAY2"
	},
	"mouse_follows_focus": true,
	"border": true,
	"border_width": 6,
	"border_offset": -1,
	"border_colours": {
		"single": "#31748f",
		"stack": "#9ccfd8",
		"monocle": "#eb6f92"
	},
	"transparency": false,
	"transparency_alpha": 200,
	"float_rule_placement": "None",
	"floating_applications": [
		{ "kind": "Exe", "id": "SnippingTool.exe", "matching_strategy": "Equals" },
		{
			"kind": "Exe",
			"id": "ScreenClippingHost.exe",
			"matching_strategy": "Equals"
		},
		{
			"kind": "Title",
			"id": "Herramienta de Recortes",
			"matching_strategy": "Contains"
		},
		{
			"kind": "Title",
			"id": "Snipping Tool",
			"matching_strategy": "Contains"
		},
		{ "kind": "Exe", "id": "steam.exe", "matching_strategy": "Equals" },
		{
			"kind": "Exe",
			"id": "RiotClientServices.exe",
			"matching_strategy": "Equals"
		},
		{ "kind": "Exe", "id": "Riot Client.exe", "matching_strategy": "Equals" },
		{ "kind": "Exe", "id": "LeagueClient.exe", "matching_strategy": "Equals" },
		{
			"kind": "Exe",
			"id": "LeagueClientUx.exe",
			"matching_strategy": "Equals"
		},
		{
			"kind": "Exe",
			"id": "League of Legends.exe",
			"matching_strategy": "Equals"
		},
		{
			"kind": "Title",
			"id": "League of Legends",
			"matching_strategy": "Contains"
		}
	],
	"work_area_offset": {
		"top": 40,
		"bottom": 0,
		"left": 0,
		"right": 0
	},
	"monitors": [
		{
			"workspaces": [
				{
					"name": "game",
					"layout": "BSP",
					"float_override": true,
					"initial_workspace_rules": [
						{ "kind": "Exe", "id": "steam.exe", "matching_strategy": "Equals" },
						{
							"kind": "Exe",
							"id": "RiotClientServices.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "Riot Client.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "LeagueClient.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "LeagueClientUx.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "League of Legends.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Title",
							"id": "League of Legends",
							"matching_strategy": "Contains"
						}
					]
				},
				{
					"name": "zen",
					"layout": "BSP",
					"initial_workspace_rules": [
						{ "kind": "Exe", "id": "zen.exe", "matching_strategy": "Equals" }
					]
				},
				{
					"name": "terminals",
					"layout": "BSP",
					"initial_workspace_rules": [
						{ "kind": "Exe", "id": "wezterm-gui.exe", "matching_strategy": "Equals" }
					]
				},
				{
					"name": "zed",
					"layout": "BSP",
					"initial_workspace_rules": [
						{ "kind": "Exe", "id": "zed.exe", "matching_strategy": "Equals" }
					]
				},
				{
					"name": "dev browsers",
					"layout": "Columns",
					"initial_workspace_rules": [
						{ "kind": "Exe", "id": "chromium.exe", "matching_strategy": "Equals" }
					]
				}
			]
		},
		{
			"workspaces": [
				{ "name": "alt", "layout": "BSP", "float_override": true }
			]
		}
	]
}
