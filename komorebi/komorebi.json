{
	"$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json",
	"default_layout": "BSP",
	"window_container_behaviour": "Create",
	"cross_monitor_move_behaviour": "Insert",
	"mouse_follows_focus": false,
	"border": true,
	"border_width": 2,
	"border_offset": -1,
	"border_colours": {
		"single": "#31748f",
		"stack": "#9ccfd8",
		"monocle": "#eb6f92"
	},
	"transparency": false,
	"transparency_alpha": 200,
	"float_rule_placement": "None",
	"floating_applications": [
		{ "kind": "Exe", "id": "steam.exe", "matching_strategy": "Equals" },
		{
			"kind": "Exe",
			"id": "RiotClientServices.exe",
			"matching_strategy": "Equals"
		},
		{ "kind": "Exe", "id": "Riot Client.exe", "matching_strategy": "Equals" },
		{ "kind": "Exe", "id": "LeagueClient.exe", "matching_strategy": "Equals" },
		{
			"kind": "Exe",
			"id": "LeagueClientUx.exe",
			"matching_strategy": "Equals"
		},
		{
			"kind": "Exe",
			"id": "League of Legends.exe",
			"matching_strategy": "Equals"
		},
		{
			"kind": "Title",
			"id": "League of Legends",
			"matching_strategy": "Contains"
		}
	],
	"work_area_offset": {
		"top": 40,
		"bottom": 0,
		"left": 0,
		"right": 0
	},
	"monitors": [
		{
			"workspaces": [
				{ "name": "dev", "layout": "BSP" },
				{ "name": "web", "layout": "Columns" },
				{ "name": "term", "layout": "BSP" },
				{ "name": "scratch", "layout": "BSP" },
				{
					"name": "game",
					"layout": "BSP",
					"initial_workspace_rules": [
						{ "kind": "Exe", "id": "steam.exe", "matching_strategy": "Equals" },
						{
							"kind": "Exe",
							"id": "RiotClientServices.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "Riot Client.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "LeagueClient.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "LeagueClientUx.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Exe",
							"id": "League of Legends.exe",
							"matching_strategy": "Equals"
						},
						{
							"kind": "Title",
							"id": "League of Legends",
							"matching_strategy": "Contains"
						}
					]
				}
			]
		},
		{
			"workspaces": [
				{ "name": "side", "layout": "BSP" },
				{ "name": "chat", "layout": "BSP" },
				{ "name": "media", "layout": "BSP" },
				{ "name": "docs", "layout": "BSP" },
				{ "name": "float", "layout": "BSP", "float_override": true }
			]
		}
	]
}
