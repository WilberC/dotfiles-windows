# dotfiles-windows/user.conf
# Copy this file to user.conf and edit to match your setup.
# user.conf is gitignored — this example file is what gets committed.

# ── Theme ────────────────────────────────────────────────────────────────────
# Options: "rose-pine" | "catppuccin-mocha"
THEME="rose-pine"

# ── Paths ────────────────────────────────────────────────────────────────────
# Your WSL2 distro name (run: wsl --list to find it)
WSL_DISTRO="Ubuntu"

# ── WezTerm ──────────────────────────────────────────────────────────────────
# Font must be a Nerd Font installed on the system — see README prerequisites
WEZTERM_FONT="BerkeleyMono Nerd Font"
WEZTERM_FONT_SIZE="13.0"
WEZTERM_OPACITY="0.92"
WEZTERM_BLUR="Acrylic"          # Acrylic | Tabbed | Mica | Disable
WEZTERM_DEFAULT_SHELL="wsl"     # wsl | pwsh | cmd

# ── Komorebi ─────────────────────────────────────────────────────────────────
KOMOREBI_LAYOUT="BSP"
KOMOREBI_BORDER="true"
KOMOREBI_BORDER_WIDTH="2"
KOMOREBI_GAP="8"
KOMOREBI_WORKSPACES="5"

# ── YASB ─────────────────────────────────────────────────────────────────────
YASB_POSITION="top"
YASB_HEIGHT="40"
YASB_BLUR="true"

# ── Optional tools ───────────────────────────────────────────────────────────
# Set any optional installer to "false" to skip it when running install.ps1.
INSTALL_FLOW_LAUNCHER="true"    # App launcher/search palette; false if you use Start, PowerToys Run, etc.
INSTALL_WINDHAWK="true"         # Windows UI patches for the full YASB/taskbar look; false keeps native UI.
