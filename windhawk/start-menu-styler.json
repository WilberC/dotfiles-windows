{
  "_mod": "windows-11-start-menu-styler",
  "_description": "Rounds and darkens the Start menu to match Rose Pine / Catppuccin. Apply these in Windhawk mod settings.",

  "controlStyles": [
    {
      "target": "Border#AcrylicBorder",
      "styles": [
        "Background:=<AcrylicBrush TintColor=\"#191724\" TintOpacity=\"0.92\" FallbackColor=\"#191724\" />",
        "CornerRadius=16",
        "BorderThickness=1",
        "BorderBrush:=<SolidColorBrush Color=\"#31748f\" Opacity=\"0.25\" />"
      ]
    },
    {
      "target": "Windows.UI.Xaml.Controls.Grid#TopLevelSuggestionsListHeader",
      "styles": [
        "Visibility=Collapsed"
      ]
    }
  ]
}
